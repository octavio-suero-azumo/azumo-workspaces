# Azumo Workspaces environment variables (NAMES ONLY).
# Copy to .env.local and fill in values locally. Never commit real values.
# Production values live only in Vercel environment variables.

# Postgres connection string (Neon in production).
# Leave EMPTY to use the local in-process PGlite database (dev/tests).
DATABASE_URL=
# Direct (non-pooled) Postgres URL. Used ONLY by `npm run db:migrate:prod`
# (preferred over DATABASE_URL for migrations). The app itself never reads it.
DATABASE_URL_UNPOOLED=
# Local PGlite data directory when DATABASE_URL is empty (default: .pglite).
PGLITE_DATA_DIR=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single allowed Google Workspace domain (the `hd` claim). Lowercase hostname,
# no wildcard, no list. The app fails closed if it is missing or invalid.
ALLOWED_GOOGLE_HD=

# Test-only auth module. Must be unset in production.
ENABLE_TEST_AUTH=

# Vercel Blob (private store) and upload limits.
BLOB_READ_WRITE_TOKEN=
# Max upload size in bytes (default 10485760 = 10 MB when empty).
UPLOAD_MAX_BYTES=
# Comma-separated MIME types (defaults to the approved P8 list when empty).
UPLOAD_ALLOWED_TYPES=
